# Copia este archivo como .env y ajusta los valores para tu entorno local.
# No subas backend/.env al repositorio.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=portfolio
DB_USER=portfolio_user
DB_PASSWORD=change_this_local_password
# Opcional: base de datos propia del catálogo. Si se omite, usa la de arriba.
# CATALOG_DB_NAME=catalogo_local
# CATALOG_DB_USER=
# CATALOG_DB_PASSWORD=
# Pagos del catálogo: solo claves del modo de pruebas de Stripe (sk_test_...).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CORS_ALLOWED_ORIGIN=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=TicketPulse
